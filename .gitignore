# Commission statements contain customer names, policy numbers and amounts.
# Keep real statements and anything extracted from them out of git history.
statements/
*.csv
*.tsv
*.xls
*.xlsx
~$*

__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store

# Persisted statements, uploaded source files and password hashes.
# Same client data as statements/, so never committed.
data/
# Scratch databases from manual testing. Same shape as data/, same client PII.
data_*/
