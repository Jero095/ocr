# Everything here is excluded from the build context.
#
# The first two entries are the important ones: both hold real client names,
# policy numbers and amounts, and data/ additionally holds password hashes.
# Without this file they would be copied into the image and shipped to the
# registry - a copy of the customer data in a place nobody thinks to look.

data/
statements/

# Anything extracted from a statement.
*.csv
*.tsv
*.xls
*.xlsx
~$*

.git/
.gitignore
.gitattributes
.claude/

__pycache__/
*.py[cod]
.venv/
venv/
.env

# Windows-only launchers; the container is Linux.
scripts/start_server.bat
scripts/start_server_hidden.vbs

# Docs are not needed at runtime and only slow the build context.
*.md
docs/

.DS_Store
